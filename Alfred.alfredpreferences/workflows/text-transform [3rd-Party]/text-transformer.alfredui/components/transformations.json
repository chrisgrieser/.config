{
  "constraints": { "region": "centre" },
  "id": "transformations",
  "type": "dataview",
  "events": [{
    "triggers": "changed",
    "action": {
      "type": "script",
      "src": "transform",
      "args": [
        "{value:self.selected.function}",
        "{value:textInput.text}"
      ]
    }
  }],
  "behaviour":  { "selection": { "wrap": "vertical" } },
  "cell": {
    "height": 32,
    "init": {
      "transformationcell.background": null,
      "title.colour": "secondaryLabelColor"
    },
    "selected": {
      "transformationcell.background": "alfredSelectedResultBackgroundColor",
      "title.colour": "alfredSelectedResultTextColor"
    },
    "root": {
      "id": "transformationcell",
      "type": "view",
      "layout": "stack",
      "cornerradius": 8,
      "components": [
        {
          "constraints": { "position": "centre", "stretch": "horizontal", "insets": { "left": 8 } },
          "id": "title",
          "type": "label",
          "font": { "size": 16 }
        }
      ]
    }
  },
  "data": {
    "filter": {
      "type": "basic",
      "args": "title.text",
      "match": "{value:searchField.text}",
      "matchmode": "wordmatchanyorder"
    },
    "src": [
      {
        "title.text": "Uppercase",
        "function": "uppercase"
      },
      {
        "title.text": "Lowercase",
        "function": "lowercase"
      },
      {
        "title.text": "Sort Lines",
        "function": "sort"
      },
      {
        "title.text": "Sort Lines Reversed",
        "function": "sortReverse"
      },
      {
        "title.text": "Randomise Lines",
        "function": "randomiseLines"
      },
      {
        "title.text": "Camel Case",
        "function": "camelCase"
      },
      {
        "title.text": "Pascal Case",
        "function": "pascalCase"
      },
      {
        "title.text": "Snake Case",
        "function": "snakeCase"
      },
      {
        "title.text": "Kebab Case",
        "function": "kebabCase"
      },
      {
        "title.text": "Base64 Encode",
        "function": "base64Encode"
      },
      {
        "title.text": "Base64 Decode",
        "function": "base64Decode"
      },
      {
        "title.text": "SHA-256 Encode",
        "function": "sha256Encode"
      },
      {
        "title.text": "SHA-512 Encode",
        "function": "sha512Encode"
      },
      {
        "title.text": "MD5 Encode",
        "function": "md5Encode"
      },
      {
        "title.text": "ROT13 Encode",
        "function": "rot13Encode"
      },
      {
        "title.text": "JSON Beautify",
        "function": "jsonBeautify"
      },
      {
        "title.text": "JSON Minify",
        "function": "jsonMinify"
      },
      {
        "title.text": "URL Encode",
        "function": "urlEncode"
      },
      {
        "title.text": "URL Decode",
        "function": "urlDecode"
      },
      {
        "title.text": "XML Encode",
        "function": "xmlEncode"
      },
      {
