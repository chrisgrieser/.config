				<key>script</key>
				<string>ObjC.import("AppKit")

function envVar(varName) {
  return $.NSProcessInfo
    .processInfo
    .environment
    .objectForKey(varName).js
}

function run(argv) {
  const url = argv[0]
  const html = `&lt;a href="${url}"&gt;${envVar("title")}&lt;/a&gt;`
  const pboard = $.NSPasteboard.generalPasteboard

  pboard.clearContents
  // Setting both will allow apps to use what’s appropriate for them
  pboard.setStringForType(html, "public.html")
  pboard.setStringForType(url, "public.utf8-plain-text")
}</string>
