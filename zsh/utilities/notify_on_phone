#!/usr/bin/env zsh

# REQUIRED Installing the `ntfy` app on the phone and adding the ID there

#-------------------------------------------------------------------------------

# stored externally, since dotfiles are public
ntfy_id=$(cat "$HOME/Library/Mobile Documents/com~apple~CloudDocs/Tech/api-keys/ntfy-sh-id.txt")
title="$1"
message="$2"

if [[ -z "$message" ]]; then
	message="$title"
	title="Notification from Desktop"
fi

#-------------------------------------------------------------------------------

# DOCS https://docs.ntfy.sh/publish/
curl \
	--header "Title: $title" \
	--data "$message" \
	"ntfy.sh/$ntfy_id" \
	&>/dev/null
